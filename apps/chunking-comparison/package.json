{
  "name": "chunking-comparison",
  "version": "1.0.0",
  "private": true,
  "description": "Compare chunking strategies on one document set with FastEmbed and Qdrant",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "compare": "node src/index.ts",
    "chunks": "node src/index.ts --chunks-only",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/textsplitters": "^1.0.2",
    "@qdrant/js-client-rest": "^1.20.0",
    "fastembed": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2"
  }
}
