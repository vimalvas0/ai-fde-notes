{
  "name": "model-router",
  "version": "1.0.0",
  "private": true,
  "description": "A routing pipeline that sends each prompt to a cheap or a strong model through LiteLLM, traced in Langfuse",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "route": "node --env-file-if-exists=.env src/route.ts",
    "demo": "node --env-file-if-exists=.env src/demo.ts",
    "tools": "node --env-file-if-exists=.env src/tools-demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langfuse/openai": "^6.1.1",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "openai": "^7.57.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
