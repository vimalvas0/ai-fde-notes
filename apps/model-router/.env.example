# Copy to .env in this folder and fill in.

# Where the LiteLLM gateway (apps/docker-compose.yml) is listening
LITELLM_BASE_URL=http://localhost:4000/v1

# Required: the same value as LITELLM_MASTER_KEY in apps/.env
LITELLM_MASTER_KEY=

# Optional: without these, routing works but nothing is sent to Langfuse.
# Create a project at https://cloud.langfuse.com and copy its API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
