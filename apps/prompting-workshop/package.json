{
  "name": "prompting-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Hit-and-trial workshop: chat under a script system prompt and see if it is zero-, one- or few-shot",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "chat": "node --env-file-if-exists=.env src/chat.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langfuse/openai": "^6.1.1",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "openai": "^7.57.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
