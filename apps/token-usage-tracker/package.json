{
  "name": "token-usage-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Track input/output tokens per user: stored locally and sent to Langfuse",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ask": "node --env-file-if-exists=.env src/ask.ts",
    "movies": "node --env-file-if-exists=.env src/movies.ts",
    "cost": "node --env-file-if-exists=.env src/cost.ts",
    "usage": "node --env-file-if-exists=.env src/usage.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langfuse/openai": "^6.1.1",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "openai": "^7.57.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
