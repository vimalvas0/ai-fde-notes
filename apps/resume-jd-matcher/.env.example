# Copy to .env in this folder and fill in.

# Primary provider
OPENAI_API_KEY=

# Fallback provider, used when an OpenAI call fails (ANTHROPIC_KEY also works)
ANTHROPIC_API_KEY=

# Optional: Gemini, through its OpenAI-compatible endpoint. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: providers to try, in order. Default "openai,anthropic". To run on Gemini only: LLM_PROVIDERS=gemini
# LLM_PROVIDERS=openai,anthropic

# Optional: model for each tier. Defaults shown.
# GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# GEMINI_STRONG_MODEL=gemini-2.5-flash
# OPENAI_FAST_MODEL=gpt-5-mini
# OPENAI_STRONG_MODEL=gpt-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# ANTHROPIC_STRONG_MODEL=claude-sonnet-5-5

# Optional: without these, nothing is traced.
# Create a project at https://cloud.langfuse.com and copy its API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: defaults to 3000
# PORT=3000
