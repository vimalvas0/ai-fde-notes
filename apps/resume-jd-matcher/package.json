{
  "name": "resume-jd-matcher",
  "version": "1.0.0",
  "private": true,
  "description": "Upload a resume, paste a job description, get a short fit verdict from a three-model pipeline",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts --prod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "openai": "^7.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
