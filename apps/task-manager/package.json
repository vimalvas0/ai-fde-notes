{
  "name": "task-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Task list driven by one AI input box: tool calls create, update and delete tasks, a small model labels time, date and location",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts --prod",
    "typecheck": "tsc --noEmit",
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml --env-file .env --no-cache",
    "eval:view": "promptfoo view"
  },
  "dependencies": {
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "express": "^5.3.0",
    "openai": "^7.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "promptfoo": "^0.126.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
