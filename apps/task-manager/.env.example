# Copy to .env in this folder and fill in.

OPENAI_API_KEY=

# Optional: models. Defaults shown.
# INTENT_MODEL=gpt-5-nano    # middle step: decides create / update / delete / unclear / unsupported
# IDENTIFY_MODEL=gpt-5-nano  # for update and delete: which task does the request mean
# AGENT_MODEL=gpt-5-mini     # reads your sentence and calls the task tools
# LABEL_MODEL=gpt-5-nano     # smaller model that pulls out time, date and location

# Optional: without these, nothing is traced.
# Create a project at https://cloud.langfuse.com and copy its API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: defaults to 3000
# PORT=3000
