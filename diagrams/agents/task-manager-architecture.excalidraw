      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Goal: decide what the user wants before anything changes.\nSees only the request, not the task list.\nReturns: { intents[], summary, message }\nintents: create, update, delete, unclear, unsupported\nChecks: zod; one retry that lists the valid intents;\na second failure becomes 'unclear' (ask to rephrase).",
      "originalText": "Goal: decide what the user wants before anything changes.\nSees only the request, not the task list.\nReturns: { intents[], summary, message }\nintents: create, update, delete, unclear, unsupported\nChecks: zod; one retry that lists the valid intents;\na second failure becomes 'unclear' (ask to rephrase).",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
