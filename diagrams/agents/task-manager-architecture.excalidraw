      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Goal: carry out the request by calling tools.\nGets: intent, the full text of the identified tasks, and only the\ntools the intent allows: create_task, update_task, delete_task.\nUpdate writes the complete new description.\nEnds with: { status: done | needs_clarification | unsupported, reply }",
      "originalText": "Goal: carry out the request by calling tools.\nGets: intent, the full text of the identified tasks, and only the\ntools the intent allows: create_task, update_task, delete_task.\nUpdate writes the complete new description.\nEnds with: { status: done | needs_clarification | unsupported, reply }",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
