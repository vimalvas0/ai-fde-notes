      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Goal: find which existing task the user means.\nReads an index, one line per task: id | summary | labels\n   e.g.  TSK-002 | Call Sara | time 17:00\nReturns: { task_ids[], question }\nChecks: every id must exist (unknown id is rejected and retried).\nA typed TSK id skips the model.",
      "originalText": "Goal: find which existing task the user means.\nReads an index, one line per task: id | summary | labels\n   e.g.  TSK-002 | Call Sara | time 17:00\nReturns: { task_ids[], question }\nChecks: every id must exist (unknown id is rejected and retried).\nA typed TSK id skips the model.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
